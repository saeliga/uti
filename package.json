{
  "name": "uti-liga-sae",
  "private": true,
  "description": "Testes e relatório de qualidade do sistema (o site em si não precisa de npm).",
  "scripts": {
    "test": "node --test testes/*.test.mjs",
    "test:cobertura": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=resultados/lcov.info --test-reporter=tap --test-reporter-destination=resultados/unidade.tap testes/*.test.mjs",
    "test:regras": "firebase emulators:exec --only firestore --project demo-uti-liga \"node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=resultados/regras.tap testes-regras/*.test.mjs\"",
    "test:confiabilidade": "firebase emulators:exec --only firestore,auth --project demo-uti-liga \"cd testes-e2e && EMULADOR=1 NOME_RESULTADO=confiabilidade RESULTADOS=../resultados python3 apoio.py test_confiabilidade.py\"",
    "test:e2e": "cd testes-e2e && python3 apoio.py",
    "relatorio": "node ferramentas/relatorio_qualidade.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@lhci/cli": "0.14.0",
    "axe-core": "4.10.2",
    "eslint": "9.13.0",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.29.0",
    "globals": "15.11.0",
    "jscpd": "4.0.5"
  }
}
