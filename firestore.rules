rules_version = '2';

// =============================================================================
// Regras de segurança do Firestore — Sistema de Evolução/SAE UTI 1 e 2 (Liga)
// Estas regras são a proteção real dos dados: o navegador pode ser adulterado,
// o servidor do Firestore não. Publicar no console: Firestore → Regras.
//
// Princípios:
// - Login somente com conta Google institucional (@liga.org.br).
// - Só usuário cadastrado, aprovado (ativo) e da unidade lê dados clínicos.
// - Ninguém altera o próprio perfil; só administrador aprova e muda perfis.
// - Internação encerrada não muda mais. Nada clínico é apagado.
// - Leito e internação só mudam juntos e de forma coerente (transação).
// - Auditoria só recebe inclusões, com autor e hora do servidor.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------ apoio
    // Só contas Google com e-mail verificado (o login do sistema é pelo Google).
    // Só conta Google do domínio institucional (@liga.org.br), com e-mail verificado.
    function logado() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@liga[.]org[.]br$');
    }
    function caminho(colecao, id) { return /databases/$(database)/documents/$(colecao)/$(id); }
    function meuPerfil() { return get(caminho('usuarios', request.auth.uid)).data; }
    function ativo() {
      return logado() && exists(caminho('usuarios', request.auth.uid))
        && meuPerfil().ativo == true && meuPerfil().perfil in ['enfermeiro', 'leitura', 'admin'];
    }
    function admin() { return ativo() && meuPerfil().perfil == 'admin'; }
    function clinico() { return ativo() && meuPerfil().perfil in ['enfermeiro', 'admin']; }
    function naUnidade(u) { return ativo() && (meuPerfil().perfil == 'admin' || u in meuPerfil().unidades); }
    function autoria() {
      return request.resource.data.atualizadoPor == request.auth.uid
        && request.resource.data.atualizadoEm == request.time;
    }
    function inalterados(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    // ------------------------------------------------------------------ usuários
    match /usuarios/{uid} {
      allow read: if (logado() && request.auth.uid == uid) || admin();

      // Cadastro próprio: nasce pendente, inativo e sem unidades. Única exceção:
      // a conta do administrador inicial, que já nasce administradora.
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome', 'coren', 'email', 'perfil', 'ativo', 'unidades', 'criadoEm'])
        && (
          (request.resource.data.perfil == 'pendente'
            && request.resource.data.ativo == false
            && request.resource.data.unidades.size() == 0)
          ||
          (request.auth.token.email == 'tercio.neto@liga.org.br'
            && request.resource.data.perfil == 'admin'
            && request.resource.data.ativo == true
            && request.resource.data.unidades is list)
        )
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 120
        && request.resource.data.coren is string && request.resource.data.coren.size() <= 20
        && request.resource.data.criadoEm == request.time;

      // Só administrador muda perfil/ativo/unidades, e nunca o próprio cadastro.
      allow update: if admin() && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['perfil', 'ativo', 'unidades', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.perfil in ['pendente', 'enfermeiro', 'leitura', 'admin']
        && request.resource.data.ativo is bool
        && request.resource.data.unidades is list
        && autoria();

      allow delete: if false;
    }

    // ------------------------------------------------------------------ unidades
    match /unidades/{unidade} {
      allow read: if ativo();
      allow create, update: if admin()
        && request.resource.data.keys().hasOnly(['nome', 'ordem', 'leitos'])
        && request.resource.data.leitos is list;
      allow delete: if false;
    }

    // ------------------------------------------------------------------ leitos
    match /leitos/{leitoId} {
      function camposLeito() {
        return request.resource.data.keys().hasOnly(
          ['unidade', 'numero', 'internacaoId', 'resumo', 'bloqueado', 'bloqueio', 'atualizadoEm', 'atualizadoPor']);
      }
      function internacaoDepois(id) { return getAfter(caminho('internacoes', id)).data; }

      allow read: if naUnidade(resource.data.unidade);

      allow create: if admin() && camposLeito()
        && leitoId == request.resource.data.unidade + '_' + request.resource.data.numero
        && request.resource.data.internacaoId == null
        && request.resource.data.bloqueado == false
        && autoria();

      allow delete: if admin() && resource.data.internacaoId == null;

      allow update: if clinico() && naUnidade(resource.data.unidade) && camposLeito()
        && inalterados(['unidade', 'numero']) && autoria()
        && (
          // (1) Ocupar: leito livre e desbloqueado, internação ativa apontando para ele.
          (resource.data.internacaoId == null && request.resource.data.internacaoId != null
            && resource.data.bloqueado == false && request.resource.data.bloqueado == false
            && internacaoDepois(request.resource.data.internacaoId).leitoId == leitoId
            && internacaoDepois(request.resource.data.internacaoId).status == 'ativa')
          ||
          // (2) Liberar: a internação saiu deste leito ou foi encerrada.
          (resource.data.internacaoId != null && request.resource.data.internacaoId == null
            && request.resource.data.resumo == null
            && (internacaoDepois(resource.data.internacaoId).leitoId != leitoId
                || internacaoDepois(resource.data.internacaoId).status != 'ativa'))
          ||
          // (3) Atualizar o resumo do paciente que continua no leito.
          (resource.data.internacaoId != null
            && request.resource.data.internacaoId == resource.data.internacaoId
            && inalterados(['bloqueado', 'bloqueio'])
            && internacaoDepois(resource.data.internacaoId).leitoId == leitoId)
          ||
          // (4) Bloquear/desbloquear leito vazio.
          (resource.data.internacaoId == null && request.resource.data.internacaoId == null
            && request.resource.data.resumo == null
            && request.resource.data.bloqueado is bool)
        );
    }

    // ------------------------------------------------------------------ pacientes
    match /pacientes/{pacienteId} {
      // Só a consulta de UM paciente pelo registro (readmissão), por quem admite.
      // Listar o cadastro inteiro de pacientes não é permitido a ninguém (minimização, LGPD).
      allow get: if clinico();
      allow list: if false;
      allow create, update: if clinico()
        && request.resource.data.keys().hasOnly(['nome', 'dataNascimento', 'registro', 'convenio', 'atualizadoEm', 'atualizadoPor'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 150
        && request.resource.data.registro is string && request.resource.data.registro.size() <= 30
        && (resource == null || request.resource.data.registro == resource.data.registro)
        && autoria();
      allow delete: if false;
    }

    // ------------------------------------------------------------------ internações
    match /internacoes/{id} {
      function leitoDepois(leitoId) { return getAfter(caminho('leitos', leitoId)).data; }
      function d() { return request.resource.data; }

      allow read: if naUnidade(resource.data.unidade);

      allow create: if clinico() && naUnidade(d().unidade)
        && d().status == 'ativa' && d().versao == 1 && d().desfecho == null
        && d().criadoPor == request.auth.uid && d().criadoEm == request.time && autoria()
        && existsAfter(caminho('pacientes', d().pacienteId))
        && leitoDepois(d().leitoId).internacaoId == id
        && leitoDepois(d().leitoId).unidade == d().unidade;

      allow update: if clinico()
        && resource.data.status == 'ativa'                       // encerrada não muda mais
        && naUnidade(resource.data.unidade) && naUnidade(d().unidade)
        && inalterados(['pacienteId', 'criadoEm', 'criadoPor'])
        && d().paciente.registro == resource.data.paciente.registro
        && d().versao == resource.data.versao + 1
        && autoria()
        && (
          (d().status == 'ativa'
            && leitoDepois(d().leitoId).internacaoId == id
            && leitoDepois(d().leitoId).unidade == d().unidade)
          ||
          (d().status == 'encerrada' && d().desfecho != null
            && d().desfecho.registradoPor == request.auth.uid
            && inalterados(['leitoId', 'unidade'])
            && leitoDepois(resource.data.leitoId).internacaoId != id)
        );

      allow delete: if false;
    }

    // ------------------------------------------------------------------ evoluções
    // Um documento por internação + dia assistencial (07h às 07h). Rascunho é editável por
    // enfermeiros da unidade; finalizada só muda para marcar a cópia ao PEP ou
    // por retificação, que guarda antes a versão anterior em /versoes.
    match /evolucoes/{id} {
      function d() { return request.resource.data; }
      function internacao(iid) { return get(caminho('internacoes', iid)).data; }
      function caminhoVersao(v) { return /databases/$(database)/documents/evolucoes/$(id)/versoes/$(v); }

      // resource == null: consultar se a evolução de um dia já existe (não revela nada).
      allow read: if ativo() && (resource == null || naUnidade(resource.data.unidade));

      allow create: if clinico() && naUnidade(d().unidade)
        && id == d().internacaoId + '_' + d().data
        && d().data is string && d().data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d().turnoInicio in ['M', 'T', 'N']
        && d().status == 'rascunho' && d().versao == 1
        && d().criadoPor == request.auth.uid && d().criadoEm == request.time && autoria()
        && internacao(d().internacaoId).status == 'ativa'
        && internacao(d().internacaoId).unidade == d().unidade;

      allow update: if clinico() && naUnidade(resource.data.unidade)
        && inalterados(['internacaoId', 'unidade', 'leitoId', 'data', 'turnoInicio', 'criadoPor', 'criadoEm'])
        && autoria()
        && (
          // (1) edição do rascunho
          (resource.data.status == 'rascunho' && d().status == 'rascunho' && d().versao == resource.data.versao)
          ||
          // (2) finalização (autor e hora do servidor)
          (resource.data.status == 'rascunho' && d().status == 'finalizada' && d().versao == resource.data.versao
            && d().finalizadoPor == request.auth.uid && d().finalizadoEm == request.time)
          ||
          // (3) marcar como transcrita ao PEP (só esse campo muda)
          (resource.data.status == 'finalizada' && d().status == 'finalizada'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['transcritoPEP', 'atualizadoEm', 'atualizadoPor', 'atualizadoNo'])
            && d().transcritoPEP.por == request.auth.uid && d().transcritoPEP.versao == resource.data.versao)
          ||
          // (4) retificação: versão anterior guardada na mesma operação
          (resource.data.status == 'finalizada' && d().status == 'rascunho' && d().versao == resource.data.versao + 1
            && d().retificacao.por == request.auth.uid
            && existsAfter(caminhoVersao(string(resource.data.versao))))
        );

      allow delete: if false;

      match /versoes/{v} {
        function evolucao() { return get(/databases/$(database)/documents/evolucoes/$(id)).data; }
        allow read: if naUnidade(evolucao().unidade);
        // A versão guardada tem de ser cópia fiel da evolução finalizada (não dá para forjar).
        allow create: if clinico() && naUnidade(evolucao().unidade)
          && evolucao().status == 'finalizada' && v == string(evolucao().versao)
          && request.resource.data.por == request.auth.uid
          && request.resource.data.versao == evolucao().versao
          && request.resource.data.dados == evolucao().dados
          && request.resource.data.finalizadoPor == evolucao().finalizadoPor;
        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------ auditoria
    // ------------------------------------------------------------------ check-list diário de IRAS
    // Um documento por unidade, dia assistencial e turno (marcações 1, 0 ou NA por leito).
    match /checklistsIras/{id} {
      function d() { return request.resource.data; }
      allow read: if ativo() && (resource == null || naUnidade(resource.data.unidade));
      allow create, update: if clinico() && naUnidade(d().unidade)
        && id == d().unidade + '_' + d().data + '_' + d().turno
        && d().data is string && d().data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d().turno in ['M', 'T', 'N']
        && d().respostas is map
        && d().keys().hasOnly(['unidade', 'data', 'turno', 'respostas', 'enfermeiro', 'atualizadoPor', 'atualizadoEm', 'atualizadoNo'])
        && autoria();
      allow delete: if false;
    }

    // ------------------------------------------------------------------ capa da ocorrência
    // Observações administrativas (reservas cirúrgicas etc.), uma por unidade e dia.
    match /capasOcorrencia/{id} {
      function d() { return request.resource.data; }
      allow read: if ativo() && (resource == null || naUnidade(resource.data.unidade));
      allow create, update: if clinico() && naUnidade(d().unidade)
        && id == d().unidade + '_' + d().data
        && d().data is string && d().data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d().observacoes is string && d().observacoes.size() <= 4000
        && d().keys().hasOnly(['unidade', 'data', 'observacoes', 'atualizadoPor', 'atualizadoEm', 'atualizadoNo'])
        && autoria();
      allow delete: if false;
    }

    // ------------------------------------------------------------------ check-lists de inserção (CVC e CVD)
    match /checklistsInsercao/{id} {
      function d() { return request.resource.data; }
      allow read: if ativo() && (resource == null || naUnidade(resource.data.unidade));
      allow create, update: if clinico() && naUnidade(d().unidade)
        && d().tipo in ['cvc', 'cvd']
        && d().internacaoId is string && id.matches('^' + d().internacaoId + '_(cvc|cvd)_[a-z0-9]+$')
        && d().respostas is map
        && d().keys().hasOnly(['tipo', 'unidade', 'internacaoId', 'leitoId', 'leitoNum', 'dispositivoId', 'data', 'respostas', 'detalhes',
             'equipe', 'observacoes', 'responsavel', 'avaliacao', 'naUti', 'setor', 'situacao', 'situacaoMotivo', 'indicacao', 'indicacaoMotivo',
             'cateter', 'lumens', 'cateterOutro', 'local', 'lado', 'localOutro', 'indicacoes', 'indicacaoEspecifique',
             'atualizadoPor', 'atualizadoEm', 'atualizadoNo'])
        && (!('observacoes' in d()) || d().observacoes.size() <= 2000)
        && (resource == null || (resource.data.unidade == d().unidade && resource.data.internacaoId == d().internacaoId && resource.data.tipo == d().tipo))
        && autoria();
      allow delete: if false;
    }

    match /auditoria/{registro} {
      // Registro das operações (LGPD art. 37): só inclusão, com autor e hora do servidor.
      allow create: if ativo()
        && request.resource.data.por == request.auth.uid
        && request.resource.data.em == request.time
        && request.resource.data.acao is string && request.resource.data.acao.size() <= 60
        && request.resource.data.keys().size() <= 12;
      allow read: if admin();
      allow update, delete: if false;
    }

    // Qualquer outra coleção: negado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
